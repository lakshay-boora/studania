# ── Angvey configuration ─────────────────────────────────────────────────────
# Copy to .env (never commit .env). Every value is optional.

# API server
ANGVEY_PORT=8787
ANGVEY_HOST=0.0.0.0

# Free tier guardrails
ANGVEY_FREE_DAILY_DOUBTS=10
ANGVEY_CHAT_RATE_LIMIT=40

# Tier-2: self-hosted open-weights LLM (Ollama / vLLM / any OpenAI-compatible)
# Leave OLLAMA_URL empty to run Tier-1 retrieval only (no GPU, ₹0 marginal cost).
OLLAMA_URL=
OLLAMA_MODEL=qwen3:8b

# Retrieval sensitivity (0–1). Lower = more matches, higher = stricter.
ANGVEY_MATCH_THRESHOLD=0.34
